+        stage["files"][name] = {
+            "descriptor": descriptor,
+            "stamp": _file_stamp(opened),
+            "sha256": digest,
+            "bytes": len(content),
+            "coordinate": coordinate,
+        }
+        record["staged_coordinates"][coordinate] = name
+        record["staged_bytes"] += len(content)
+        os.fsync(stage["descriptor"])
+        self.append(
+            {
+                "event": "metadata-write-completed",
+                "coordinate": coordinate,
+                "name": name,
+                "sha256": digest,
+                "bytes": len(content),
+            }
+        )
