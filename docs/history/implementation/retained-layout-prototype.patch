--- /dev/null
+++ b/src/literate_ai/adapters/retained_layout_compiler.py
@@ -0,0 +1,73 @@
+"""Compile a complete finite relocation intent from original live observations.
+
+The body is reviewable data. Neither it nor its identity restores source,
+publication, host-execution or recovery ownership. Application recompiles under
+its own canonical project lifecycle lock before creating its original journal.
+"""
+
+from __future__ import annotations
+
+from literate_ai.adapters.retained_layout import _fail
+from literate_ai.adapters.retained_layout_metadata import _derive_relocation_metadata
+from literate_ai.adapters.retained_layout_partition import _require_original
+from literate_ai.adapters.retained_layout_transaction import (
+    _compile_relocation_transaction,
+)
+from literate_ai.contracts.identity import canonical_identity
+
+
+def compile_retained_layout_transition(context, declaration, *, limits, case_sensitive):
+    """Bind source geometry and exact old/new affected authority in one plan.
+
+    The input must be an originally issued current context. No data-only source
+    policy, old plan or saved journal is accepted in place of that context.
+    """
+    record = _require_original(context)
+    transaction = _compile_relocation_transaction(
+        context, declaration, limits=limits, case_sensitive=case_sensitive
+    )
+    plan = transaction["source_plan"]
+    # Both existing source-plan forms remain live while metadata is decoded and
+    # serialized. Admit their physical/index/string graphs before the additional
+    # compiler graph, not after canonical identity materializes its JSON bytes.
+    reservation = (
+        16384 * (len(plan["source_nodes"]) + len(record["files"]))
+        + sum(256 * len(row["path"].encode()) for row in plan["source_nodes"])
+        + 4096 * len(plan["root_existing_partition"] or ())
+    )
+    context.require_framework_current(reserved_memory_bytes=reservation)
+    metadata = _derive_relocation_metadata(
+        context, plan, reserved_memory_bytes=reservation
+    )
+    # All prospective metadata coordinates must come from the finite actual
+    # framework roles or their explicitly selected wrapper relocation. Data in
+    # the baseline never authorizes arbitrary extra authored-file replacement.
+    old_wrapper = context.layout.declaration.wrapper_component
+    new_wrapper = declaration.wrapper_component
+    allowed = set(record["files"])
+    allowed.update(
+        new_wrapper + name[len(old_wrapper) :]
+        for name in record["files"]
+        if name.startswith(old_wrapper + "/")
+    )
+    if any(row["path"] not in allowed for row in metadata["replacements"]):
+        _fail("metadata_program_invalid", "metadata exceeds original framework roles")
+    body = {
+        "schema": "literate-ai/retained-layout-transition@1",
+        "project_id": plan["project_id"],
+        "root": plan["root"],
+        "source_plan": plan,
+        "source_operations": transaction["source_operations"],
+        "metadata_operations": metadata,
+        "requalification_required": True,
+        "old_receipt_rewritten": False,
+        "repository_root_move": False,
+    }
+    context.require_framework_current(
+        reserved_memory_bytes=reservation + metadata["admitted_memory_bytes"]
+    )
+    identity = canonical_identity(body)
+    context.require_framework_current(
+        reserved_memory_bytes=reservation + metadata["admitted_memory_bytes"]
+    )
+    return {"plan": body, "plan_identity": identity.uri}
diff --git a/src/literate_ai/adapters/retained_layout_execution.py b/src/literate_ai/adapters/retained_layout_execution.py
new file mode 100644
index 0000000000000000000000000000000000000000..166a2331b3446c6130ea96bd3ee9e1f72eb2c0d6
--- /dev/null
+++ b/src/literate_ai/adapters/retained_layout_execution.py
@@ -0,0 +1,273 @@
+"""Original complete source views inside opt-in disposable harness workspaces.
+
+A fresh full capture establishes protected inputs before any pipeline command.
+Later additions are command artifacts in this private copy, never exclusions
+from the original project's complete source observation. Views are weak-issued,
+PID/thread-scoped and retired; neither inventory paths nor saved JSON can create
+or revive one. This observer grants no command or filesystem mutation authority.
+"""
+
+from __future__ import annotations
+
+import os
+import threading
+import weakref
+from contextlib import contextmanager
+from contextvars import ContextVar
+from dataclasses import dataclass
+from pathlib import Path
+
+from literate_ai._filesystem import require_safe_directory
+from literate_ai.adapters.retained_layout import _fail
+from literate_ai.adapters.retained_layout_partition import (
+    _layout_source_identity,
+    _native_mode_memory,
+    _native_modes,
+)
+from literate_ai.contracts.identity import ContentIdentity
+from literate_ai.contracts.native_sdks import NativeSdkFile
+from literate_ai.contracts.retained_layout import RetainedLayoutSourcePolicy
+
+_ISSUED = weakref.WeakKeyDictionary()
+_CURRENT = ContextVar("retained_layout_execution_source", default=None)
+_CONTROL_MEMORY = 64 * 1024
+
+
+def _admit(policy, retained):
+    if retained > policy.maximum_metadata_bytes:
+        _fail(
+            "metadata_limit", "layout execution source view exceeds its memory policy"
+        )
+
+
+def _capture(root, policy, reserved):
+    from .native_sdk_tree_custody import _capture_composed_native_tree
+
+    return _capture_composed_native_tree(
+        root,
+        store=None,
+        limits=policy.limits,
+        case_sensitive=policy.case_sensitive,
+        max_metadata_memory_bytes=policy.maximum_metadata_bytes,
+        reserved_memory_bytes=reserved,
+        budget_capture=True,
+        retain_payloads=False,
+    )
+
+
+def _modes(root, policy, tree, reserved):
+    memory = _native_mode_memory(tree)
+    _admit(policy, reserved + tree.index.metadata_memory_bound + memory)
+    return _native_modes(root, tree), memory
+
+
+def _original(owner):
+    if type(owner) is not _ExecutionSourceView:
+        _fail(
+            "original_execution_view_required",
+            "original execution source view required",
+        )
+    record = _ISSUED.get(owner)
+    if (
+        record is None
+        or not record["active"]
+        or record["pid"] != os.getpid()
+        or record["thread"] is not threading.current_thread()
+    ):
+        _fail(
+            "original_execution_view_required",
+            "execution source observation ended or changed",
+        )
+    require_safe_directory(record["root"])
+    node = record["root"].lstat()
+    actual = (node.st_dev, node.st_ino, node.st_mode, node.st_uid, node.st_gid)
+    if actual != record["node"]:
+        _fail("workspace_changed", "original execution source root was replaced")
+    return record
+
+
+def _protected(record, actual, modes, retained):
+    from .native_tree_shards import prepare_native_tree
+
+    before, policy = record["tree"], record["policy"]
+    count = (
+        len(actual.directories)
+        + len(actual.files)
+        + len(actual.aliases)
+        + len(before.directories)
+        + len(before.files)
+        + len(before.aliases)
+    )
+    # Admit full resolution maps and a simultaneous protected projection BEFORE
+    # their allocation, while both original and post-command graphs are live.
+    _admit(policy, retained + 2048 * count + before.index.metadata_memory_bound)
+    directories = set(actual.directories)
+    aliases = {item.path: item for item in actual.aliases}
+    files = {item.path: item for item in actual.files}
+    modes_by_name = dict(modes)
+    if any(name not in directories for name in before.directories):
+        _fail(
+            "source_changed",
+            "protected source directory disappeared or became an alias",
+        )
+    regular_names = tuple(
+        sorted(
+            [item.path for item in before.files]
+            + [item.path for item in before.aliases if item.kind == "hardlink"]
+        )
+    )
+    for name in regular_names:
+        alias = aliases.get(name)
+        if name not in files and (alias is None or alias.kind != "hardlink"):
+            _fail(
+                "source_changed",
+                "protected regular source member changed kind or disappeared",
+            )
+    resolved = dict(zip(regular_names, actual.resolve_all(regular_names), strict=True))
+    representatives = {resolved[item.path] for item in before.files}
+    if len(representatives) != len(before.files):
+        _fail("source_changed", "distinct protected source groups became hardlinked")
+    for item in before.aliases:
+        if item.kind == "hardlink":
+            if resolved[item.path] != resolved[item.target]:
+                _fail("source_changed", "protected source hardlink group split")
+        elif aliases.get(item.path) != item:
+            _fail("source_changed", "protected source symbolic target changed")
+    protected_files = tuple(
+        NativeSdkFile(
+            item.path,
+            files[resolved[item.path]].blob,
+            bool(modes_by_name[item.path] & 0o111),
+        )
+        for item in before.files
+    )
+    index = before.index
+    protected = prepare_native_tree(
+        before.directories,
+        protected_files,
+        before.aliases,
+        limits=policy.limits,
+        case_sensitive=policy.case_sensitive,
+        max_descriptor_bytes=index.max_descriptor_bytes,
+        max_descriptor_total_bytes=index.max_descriptor_total_bytes,
+        max_index_bytes=index.max_index_bytes,
+        max_metadata_memory_bytes=policy.maximum_metadata_bytes,
+        reserved_memory_bytes=retained + 2048 * count,
+    )
+    protected_modes = tuple((name, modes_by_name[name]) for name, _ in record["modes"])
+    return _layout_source_identity(protected.identity, protected_modes)
+
+
+@dataclass(frozen=True, slots=True, weakref_slot=True, eq=False)
+class _ExecutionSourceView:
+    def __reduce__(self):
+        raise TypeError("retained.layout.execution-view-not-transportable")
+
+    def observe(self):
+        record = _original(self)
+        policy, root = record["policy"], record["root"]
+        baseline = record["memory"]
+        actual = _capture(root, policy, baseline)
+        modes, mode_memory = _modes(root, policy, actual, baseline)
+        retained = baseline + actual.index.metadata_memory_bound + mode_memory
+        protected = _protected(record, actual, modes, retained)
+        closing = _capture(root, policy, retained)
+        closing_modes, _ = _modes(root, policy, closing, retained)
+        if closing.identity != actual.identity or closing_modes != modes:
+            _fail("workspace_changed", "execution workspace changed during observation")
+        _original(self)
+        if protected != record["identity"]:
+            _fail(
+                "source_changed",
+                "pipeline changed protected source bytes, modes or topology",
+            )
+        source = {
+            "identity": protected.uri,
+            "file_count": record["file_count"],
+            "missing_count": 0,
+            "total_bytes": record["source_bytes"],
+            "scope": "complete-retained-layout@1",
+        }
+        artifact = {
+            "identity": _layout_source_identity(actual.identity, modes).uri,
+            "file_count": len(actual.files) + len(actual.aliases),
+            "missing_count": 0,
+            "total_bytes": sum(item.blob.size for item in actual.files)
+            + sum(
+                len(item.target.encode("utf-8"))
+                for item in actual.aliases
+                if item.kind == "symlink"
+            ),
+            "scope": "complete-disposable-layout-workspace@1",
+            "excluded": [],
+        }
+        return {"tree": artifact, "source_tree": source, "excluded": []}
+
+
+@contextmanager
+def _observe_layout_execution_source(root, scope, *, expected_source_identity):
+    """Issue from fresh actual complete source, never a supplied member list."""
+    if not isinstance(expected_source_identity, ContentIdentity):
+        raise TypeError("retained.layout.typed-execution-source-identity-required")
+    policy = RetainedLayoutSourcePolicy.from_dict(scope)
+    root = Path(root)
+    require_safe_directory(root)
+    if not root.is_absolute() or root.resolve(strict=True) != root:
+        _fail("workspace_unsafe", "execution source must be an actual direct root")
+    node = root.lstat()
+    tree = _capture(root, policy, _CONTROL_MEMORY)
+    modes, mode_memory = _modes(root, policy, tree, _CONTROL_MEMORY)
+    memory = _CONTROL_MEMORY + tree.index.metadata_memory_bound + mode_memory
+    closing = _capture(root, policy, memory)
+    closing_modes, _ = _modes(root, policy, closing, memory)
+    if closing.identity != tree.identity or closing_modes != modes:
+        _fail("source_changed", "execution source changed during original observation")
+    identity = _layout_source_identity(tree.identity, modes)
+    if identity != expected_source_identity:
+        _fail(
+            "source_changed",
+            "execution source differs from actual admitted project inputs",
+        )
+    del closing, closing_modes
+    owner = _ExecutionSourceView()
+    record = {
+        "active": True,
+        "pid": os.getpid(),
+        "thread": threading.current_thread(),
+        "root": root,
+        "node": (node.st_dev, node.st_ino, node.st_mode, node.st_uid, node.st_gid),
+        "policy": policy,
+        "tree": tree,
+        "modes": modes,
+        "memory": memory,
+        "identity": identity,
+        "file_count": len(tree.files) + len(tree.aliases),
+        "source_bytes": sum(item.blob.size for item in tree.files)
+        + sum(
+            len(item.target.encode("utf-8"))
+            for item in tree.aliases
+            if item.kind == "symlink"
+        ),
+    }
+    _ISSUED[owner] = record
+    token = _CURRENT.set(owner)
+    try:
+        _original(owner)
+        yield owner
+        owner.observe()
+    finally:
+        _CURRENT.reset(token)
+        record["active"] = False
+        _ISSUED.pop(owner, None)
+
+
+def _current_layout_execution_observation(root, scope):
+    owner = _CURRENT.get()
+    record = _original(owner)
+    policy = RetainedLayoutSourcePolicy.from_dict(scope)
+    if Path(root) != record["root"] or policy != record["policy"]:
+        _fail(
+            "original_execution_view_required",
+            "execution source view belongs to another root or policy",
+        )
+    return owner.observe()
diff --git a/src/literate_ai/adapters/retained_layout_inspection.py b/src/literate_ai/adapters/retained_layout_inspection.py
new file mode 100644
index 0000000000000000000000000000000000000000..3fc92a7d3cd3670194a9ed33518d42317af7218e
--- /dev/null
+++ b/src/literate_ai/adapters/retained_layout_inspection.py
@@ -0,0 +1,439 @@
+"""Read-only native source queries for canonical harness inspection at root.
+
+This is a query adapter over an original complete capture, not a replacement
+filesystem, path-based exclusion convention or serialized source owner. Existing
+canonical detectors see retained members only; every read rejoins actual bytes,
+and a complete closing capture rejects namespace/content/mode drift. No write,
+command-execution or recovery capability is issued.
+"""
+
+from __future__ import annotations
+
+import fnmatch
+import hashlib
+import io
+import os
+import threading
+import weakref
+from contextlib import contextmanager
+from dataclasses import dataclass
+from pathlib import Path, PurePosixPath
+
+from literate_ai.adapters.retained_layout import RetainedLayoutError, _fail
+from literate_ai.adapters.retained_layout_partition import (
+    _layout_modes,
+    _layout_source_identity,
+    _require_original,
+    _signature,
+    capture_retained_layout_source,
+)
+from literate_ai.adapters.retained_project_inputs import _directory_access, _stream
+from literate_ai.contracts.native_sdk_trees import NativeSdkTree, _ResolutionBudget
+from literate_ai.contracts.paths import canonical_relative_posix_path
+
+_VIEWS = weakref.WeakKeyDictionary()
+_PATHS = weakref.WeakKeyDictionary()
+
+
+def _original(view):
+    record = _VIEWS.get(view)
+    if (
+        record is None
+        or not record["active"]
+        or record["pid"] != os.getpid()
+        or record["thread"] is not threading.current_thread()
+    ):
+        _fail("original_inspection_required", "original source inspection has retired")
+    if record["failure"] is not None:
+        raise RetainedLayoutError(*record["failure"])
+    try:
+        _require_original(record["context"])
+        record["access"].require_current()
+    except (ValueError, OSError) as exc:
+        record["failure"] = (
+            getattr(exc, "code", "retained.layout.source_changed"),
+            "original source inspection custody is no longer current",
+        )
+        raise RetainedLayoutError(*record["failure"]) from exc
+    return record
+
+
+def _refuse(record, suffix, message):
+    # Canonical metadata parsers may catch ValueError for malformed TOML/JSON.
+    # Keep a private monotonic denial so such a catch can never hide a source or
+    # resource failure: the factory replays it before any successful return.
+    record["failure"] = ("retained.layout." + suffix, message)
+    raise RetainedLayoutError(*record["failure"])
+
+
+def _admit(record, amount):
+    context = _require_original(record["context"])
+    record["memory"] += amount
+    if record["memory"] + context["retained"] > context["maximum"]:
+        _refuse(
+            record,
+            "metadata_limit",
+            "source inspection exceeds original metadata memory",
+        )
+
+
+def _selected(path):
+    selected = _PATHS.get(path)
+    if selected is None:
+        _fail("original_inspection_required", "original source query path required")
+    owner, relative = selected
+    return _original(owner), relative
+
+
+def _path(owner, relative):
+    record = _original(owner)
+    if relative != ".":
+        candidate = PurePosixPath(relative)
+        if (
+            candidate.is_absolute()
+            or candidate.as_posix() != relative
+            or any(part in {"..", ""} for part in candidate.parts)
+        ):
+            _refuse(
+                record, "inspection_escape", "source query escaped its original root"
+            )
+        try:
+            canonical_relative_posix_path(relative, label="original source query")
+        except ValueError:
+            _refuse(record, "inspection_escape", "canonical source query required")
+    result = record["paths"].get(relative)
+    if result is None:
+        _admit(record, 2048 + 64 * len(relative.encode()))
+        result = _InspectionPath()
+        _PATHS[result] = (owner, relative)
+        record["paths"][relative] = result
+    return result
+
+
+def _resolve(record, relative):
+    if record["failure"] is not None:
+        raise RetainedLayoutError(*record["failure"])
+    if relative == ".":
+        return "."
+    cache = record["resolutions"]
+    if relative in cache:
+        return cache[relative]
+    # Reuse the original already-admitted complete indexes. ComposedTree's
+    # convenience resolve_all intentionally rebuilds them for a whole batch;
+    # using that convenience entrypoint for every leaf would be quadratic.
+    _admit(record, 512 + 64 * len(relative.encode()))
+    try:
+        canonical_relative_posix_path(relative, label="original source query")
+    except ValueError:
+        _refuse(record, "inspection_escape", "canonical source query required")
+    try:
+        resolved = NativeSdkTree._resolve(
+            relative,
+            record["directories"],
+            record["files"],
+            record["aliases"],
+            record["resolution_budget"],
+        )
+    except ValueError as exc:
+        if record["resolution_budget"].remaining < 0:
+            _refuse(record, "metadata_limit", "source query resolution work exhausted")
+        if str(exc) not in {
+            "SDK alias target is absent from its inventoried tree",
+            "SDK alias traverses a non-directory",
+        }:
+            _refuse(
+                record, "source_invalid", "canonical source alias resolution failed"
+            )
+        resolved = None
+    cache[relative] = resolved
+    return resolved
+
+
+def _glob_match(parts, pattern):
+    # A small dynamic program preserves component-wise pathlib glob semantics;
+    # '**' consumes zero or more components. Only already-captured names are
+    # enumerated, so a new tree/alias cannot expand the query beyond its budget.
+    reachable = {0}
+    for piece in pattern:
+        following = set()
+        for index in reachable:
+            if piece == "**":
+                following.update(range(index, len(parts) + 1))
+            elif index < len(parts) and fnmatch.fnmatchcase(parts[index], piece):
+                following.add(index + 1)
+        reachable = following
+    return len(parts) in reachable
+
+
+@dataclass(frozen=True, slots=True, weakref_slot=True, eq=False)
+class _InspectionPath:
+    def __reduce__(self):
+        raise TypeError("retained.layout.inspection-path-not-transportable")
+
+    def __fspath__(self):
+        record, relative = _selected(self)
+        return os.fspath(record["root"] / relative)
+
+    def __str__(self):
+        return self.__fspath__()
+
+    def __lt__(self, other):
+        if not isinstance(other, _InspectionPath):
+            return NotImplemented
+        return str(self) < str(other)
+
+    def __truediv__(self, child):
+        record, relative = _selected(self)
+        child = PurePosixPath(child)
+        if child.is_absolute() or ".." in child.parts:
+            _refuse(record, "inspection_escape", "relative source query required")
+        return _path(_PATHS[self][0], (PurePosixPath(relative) / child).as_posix())
+
+    @property
+    def name(self):
+        record, relative = _selected(self)
+        return (record["root"] / relative).name
+
+    @property
+    def suffix(self):
+        return PurePosixPath(self.name).suffix
+
+    @property
+    def stem(self):
+        return PurePosixPath(self.name).stem
+
+    @property
+    def parent(self):
+        _, relative = _selected(self)
+        if relative == ".":
+            _refuse(
+                _selected(self)[0],
+                "inspection_escape",
+                "source query parent is outside its root",
+            )
+        return _path(_PATHS[self][0], PurePosixPath(relative).parent.as_posix())
+
+    def as_posix(self):
+        return str(self)
+
+    def relative_to(self, other):
+        return Path(str(self)).relative_to(Path(os.fspath(other)))
+
+    def resolve(self, strict=False):
+        record, relative = _selected(self)
+        resolved = _resolve(record, relative)
+        if resolved is None:
+            if strict:
+                raise FileNotFoundError(relative)
+            return self
+        return _path(_PATHS[self][0], resolved)
+
+    def is_file(self):
+        record, relative = _selected(self)
+        selected = record["files"].get(_resolve(record, relative))
+        if selected is not None:
+            # Some canonical stdlib readers consume a filename after this
+            # query. Admit that parse too, before any such allocation occurs.
+            _admit(record, 16 * selected.blob.size)
+        return selected is not None
+
+    def is_dir(self):
+        record, relative = _selected(self)
+        target = _resolve(record, relative)
+        return target == "." or target in record["directories"]
+
+    def exists(self):
+        record, relative = _selected(self)
+        return _resolve(record, relative) is not None
+
+    def is_symlink(self):
+        record, relative = _selected(self)
+        if relative == ".":
+            return False
+        name = PurePosixPath(relative)
+        parent = _resolve(record, name.parent.as_posix())
+        if parent is None:
+            return False
+        actual = (PurePosixPath(parent) / name.name).as_posix()
+        alias = record["aliases"].get(actual)
+        return alias is not None and alias.kind == "symlink"
+
+    def read_bytes(self):
+        record, relative = _selected(self)
+        resolved = _resolve(record, relative)
+        selected = record["files"].get(resolved)
+        if selected is None:
+            raise FileNotFoundError(relative)
+        _admit(record, 16 * selected.blob.size)
+        access = record["access"]
+        if access is None:
+            _fail("native_owner_unavailable", "original source query handles required")
+        try:
+            node = access.metadata(record["root"] / resolved)
+            stream = io.BytesIO()
+            _stream(record["root"], resolved, selected.blob.size, stream, access=access)
+            raw = stream.getvalue()
+            if (
+                _signature(access.metadata(record["root"] / resolved))
+                != _signature(node)
+                or hashlib.sha256(raw).hexdigest() != selected.blob.digest
+                or len(raw) != selected.blob.size
+            ):
+                _refuse(
+                    record, "source_changed", "original inspected source bytes changed"
+                )
+        except (OSError, ValueError) as exc:
+            if record["failure"] is None:
+                record["failure"] = (
+                    "retained.layout.source_changed",
+                    "original inspected source is no longer readable",
+                )
+            raise RetainedLayoutError(*record["failure"]) from exc
+        return raw
+
+    def read_text(self, encoding=None, errors=None):
+        return self.read_bytes().decode(encoding or "utf-8", errors or "strict")
+
+    def iterdir(self):
+        yield from self.glob("*")
+
+    def rglob(self, pattern):
+        yield from self.glob("**/" + pattern)
+
+    def glob(self, pattern):
+        record, relative = _selected(self)
+        if type(pattern) is not str or len(pattern) > 4096:
+            _refuse(
+                record, "metadata_limit", "source glob exceeds its finite query bound"
+            )
+        pieces = PurePosixPath(pattern).parts
+        if len(pieces) > 128:
+            _refuse(record, "metadata_limit", "source glob exceeds its component bound")
+        if PurePosixPath(pattern).is_absolute() or ".." in pieces:
+            _refuse(record, "inspection_escape", "source glob must remain relative")
+        resolved = _resolve(record, relative)
+        if resolved != "." and resolved not in record["directories"]:
+            return
+        prefix = "" if resolved == "." else resolved + "/"
+        for name in record["names"]:
+            if not name.startswith(prefix):
+                continue
+            tail = name[len(prefix) :]
+            if tail and _glob_match(PurePosixPath(tail).parts, pieces):
+                yield _path(
+                    _PATHS[self][0], (PurePosixPath(relative) / tail).as_posix()
+                )
+
+
+@dataclass(frozen=True, slots=True, weakref_slot=True, eq=False)
+class _InspectionOwner:
+    def __reduce__(self):
+        raise TypeError("retained.layout.inspection-not-transportable")
+
+
+@contextmanager
+def _inspect_source_paths_open(context, access):
+    _require_original(context)
+    publication = context.layout.publication
+    if publication is None:
+        _fail("transition_required", "complete layout publication is required")
+    policy = publication.source_policy
+    tree = capture_retained_layout_source(
+        context, limits=policy.limits, case_sensitive=policy.case_sensitive
+    )
+    modes, mode_memory = _layout_modes(context, tree, reserved_memory_bytes=0)
+    index_memory = 4096 * (len(tree.files) + len(tree.aliases) + len(tree.directories))
+    memory = tree.index.metadata_memory_bound + mode_memory + index_memory
+    context.require_framework_current(reserved_memory_bytes=memory)
+    owner = _InspectionOwner()
+    issued = {
+        "active": True,
+        "pid": os.getpid(),
+        "thread": threading.current_thread(),
+        "context": context,
+        "access": access,
+        "root": context.layout.implementation,
+        "tree": tree,
+        "directories": set(tree.directories),
+        "files": {x.path: x for x in tree.files},
+        "aliases": {x.path: x for x in tree.aliases},
+        "names": tuple(
+            sorted(
+                (
+                    *tree.directories,
+                    *(x.path for x in tree.files),
+                    *(x.path for x in tree.aliases),
+                )
+            )
+        ),
+        "paths": {},
+        "resolutions": {},
+        "resolution_budget": _ResolutionBudget(),
+        "failure": None,
+        "memory": memory,
+    }
+    _VIEWS[owner] = issued
+    try:
+        yield _path(owner, "."), _layout_source_identity(tree.identity, modes)
+        _original(owner)
+        closing = capture_retained_layout_source(
+            context,
+            limits=policy.limits,
+            case_sensitive=policy.case_sensitive,
+            reserved_memory_bytes=issued["memory"],
+        )
+        closing_modes, _ = _layout_modes(
+            context, closing, reserved_memory_bytes=issued["memory"]
+        )
+        if closing.identity != tree.identity or closing_modes != modes:
+            _fail("source_changed", "source changed during harness inspection")
+        del closing, closing_modes
+    finally:
+        issued["active"] = False
+        _VIEWS.pop(owner, None)
+        issued.clear()
+        del tree, modes
+
+
+@contextmanager
+def _inspect_source_paths(context):
+    record = _require_original(context)
+    with _directory_access(record["source_root"]) as access:
+        if access is None:
+            _fail("native_owner_unavailable", "original source query handles required")
+        with _inspect_source_paths_open(context, access) as observation:
+            yield observation
+
+
+def inspect_retained_layout_harness(context):
+    """Reuse canonical detectors through original source-only read queries."""
+    from .harness_inventory import (
+        HARNESS_INVENTORY_SCHEMA,
+        _detect_build_system,
+        _detect_gitlab_ci,
+        _detect_operating_systems,
+        _detect_packaging,
+        _detect_release_workflow,
+        classify_ci,
+    )
+
+    with _inspect_source_paths(context) as (root, identity):
+        detected, commands, stages = _detect_build_system(root)
+        findings = [
+            *detected,
+            *_detect_packaging(root),
+            *_detect_operating_systems(root),
+            *_detect_gitlab_ci(root),
+            *_detect_release_workflow(root),
+        ]
