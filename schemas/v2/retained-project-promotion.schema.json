{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literate-ai:schema:v2:retained-project-promotion-contracts",
  "description": "Historical evidence records never issue live admission or release authority. Existing public identifiers retain their current native runtime wire format.",
  "oneOf": [
    {
      "$ref": "literate-ai/retained-project-promotion-evidence@1"
    },
    {
      "$ref": "literate-ai/retained-project-admission-assertion@1"
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "json_blob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest",
        "size",
        "media_type"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "const": "application/json"
        }
      }
    },
    "promotion": {
      "$id": "literate-ai/retained-project-promotion-evidence@1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "retained_receipt_identity",
        "planning_evidence",
        "accepted_run_evidence",
        "admitted",
        "release_authorized",
        "workspace_admission"
      ],
      "properties": {
        "schema": {
          "const": "literate-ai/retained-project-promotion-evidence@1"
        },
        "retained_receipt_identity": {
          "$ref": "urn:literate-ai:schema:v2:retained-project-promotion-contracts#/$defs/digest"
        },
        "planning_evidence": {
          "$ref": "urn:literate-ai:schema:v2:retained-project-promotion-contracts#/$defs/json_blob"
        },
        "accepted_run_evidence": {
          "$ref": "urn:literate-ai:schema:v2:retained-project-promotion-contracts#/$defs/json_blob"
        },
        "admitted": {
          "type": "boolean",
          "const": false
        },
        "release_authorized": {
          "type": "boolean",
          "const": false
        },
        "workspace_admission": {
          "$ref": "urn:literate-ai:schema:v2:retained-project-promotion-contracts#/$defs/json_blob"
        }
      }
    },
    "admission": {
      "$id": "literate-ai/retained-project-admission-assertion@1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "retained_receipt_identity",
        "planning_evidence",
        "accepted_run_evidence",
        "admitted",
        "release_authorized",
        "capture_origin",
        "plan_identity",
        "completed_run_identity",
        "input_manifest_identity",
        "output_manifest_identity",
        "payload_manifest_identity",
        "source_observation_identity",
        "resolved_observation_identity",
        "test_policy_identity",
        "project_test_policy_identity",
        "acceptance_policy_identity",
        "command_count",
        "test_report_count",
        "acceptance_case_count",
        "native_sdk_scope_checked"
      ],
      "properties": {
        "schema": {
          "const": "literate-ai/retained-project-admission-assertion@1"
        },
        "retained_receipt_identity": {
          "$ref": "urn:literate-ai:schema:v2:retained-project-promotion-contracts#/$defs/digest"
        },
        "planning_evidence": {
          "$ref": "urn:literate-ai:schema:v2:retained-project-promotion-contracts#/$defs/json_blob"
        },
        "accepted_run_evidence": {
          "$ref": "urn:literate-ai:schema:v2:retained-project-promotion-contracts#/$defs/json_blob"
        },
        "admitted": {
          "type": "boolean",
          "const": false
        },
        "release_authorized": {
          "type": "boolean",
          "const": false
        },
        "capture_origin": {
          "const": "original-live-retained-runtime"
        },
        "plan_identity": {
          "$ref": "urn:literate-ai:schema:v2:retained-project-promotion-contracts#/$defs/digest"
        },
        "completed_run_identity": {
          "$ref": "urn:literate-ai:schema:v2:retained-project-promotion-contracts#/$defs/digest"
        },
        "input_manifest_identity": {
          "$ref": "urn:literate-ai:schema:v2:retained-project-promotion-contracts#/$defs/digest"
        },
        "output_manifest_identity": {
          "$ref": "urn:literate-ai:schema:v2:retained-project-promotion-contracts#/$defs/digest"
        },
        "payload_manifest_identity": {
          "$ref": "urn:literate-ai:schema:v2:retained-project-promotion-contracts#/$defs/digest"
        },
        "source_observation_identity": {
          "$ref": "urn:literate-ai:schema:v2:retained-project-promotion-contracts#/$defs/digest"
        },
        "resolved_observation_identity": {
          "$ref": "urn:literate-ai:schema:v2:retained-project-promotion-contracts#/$defs/digest"
        },
        "test_policy_identity": {
          "$ref": "urn:literate-ai:schema:v2:retained-project-promotion-contracts#/$defs/digest"
        },
        "project_test_policy_identity": {
          "$ref": "urn:literate-ai:schema:v2:retained-project-promotion-contracts#/$defs/digest"
        },
        "acceptance_policy_identity": {
          "$ref": "urn:literate-ai:schema:v2:retained-project-promotion-contracts#/$defs/digest"
        },
        "command_count": {
          "type": "integer",
          "minimum": 0
        },
        "test_report_count": {
          "type": "integer",
          "minimum": 0
        },
        "acceptance_case_count": {
          "type": "integer",
          "minimum": 0
        },
        "native_sdk_scope_checked": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
