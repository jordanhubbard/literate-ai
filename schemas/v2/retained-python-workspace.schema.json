{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "literate-ai/retained-python-workspace-plan@1",
  "description": "Inert reviewed Python receiving intent. Parsing grants no provider, import, installation, execution, retirement or admission authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "importer_project_id",
    "wrapper_component",
    "harness_inventory",
    "source_scope_identity",
    "test_inventory",
    "gate_policy",
    "interpreter_identity",
    "target_identity",
    "environment_identity",
    "exports",
    "destinations",
    "mounts",
    "source_changes",
    "retired_roots",
    "budget"
  ],
  "properties": {
    "schema": {
      "const": "literate-ai/retained-python-workspace-plan@1"
    },
    "importer_project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "wrapper_component": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "harness_inventory": {
      "allOf": [
        {
          "$ref": "urn:literate-ai:schema:v1:blob-ref"
        },
        {
          "properties": {
            "size": {
              "minimum": 1,
              "maximum": 16777216
            },
            "media_type": {
              "const": "application/json"
            }
          },
          "required": [
            "media_type"
          ]
        }
      ]
    },
    "source_scope_identity": {
      "$ref": "urn:literate-ai:schema:v1:content-identity"
    },
    "test_inventory": {
      "allOf": [
        {
          "$ref": "urn:literate-ai:schema:v1:blob-ref"
        },
        {
          "properties": {
            "size": {
              "minimum": 1,
              "maximum": 16777216
            },
            "media_type": {
              "const": "application/json"
            }
          },
          "required": [
            "media_type"
          ]
        }
      ]
    },
    "gate_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "importer_project_id",
        "commands",
        "toolchains"
      ],
      "properties": {
        "schema": {
          "const": "literate-ai/retained-library-gate-policy@1"
        },
        "importer_project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step_id",
              "argv",
              "working_directory",
              "environment",
              "network"
            ],
            "properties": {
              "step_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "argv": {
                "type": "array",
                "minItems": 1,
                "maxItems": 128,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                }
              },
              "working_directory": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "environment": {
                "type": "array",
                "minItems": 0,
                "maxItems": 128,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "value"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "value": {
                      "type": "string",
                      "maxLength": 8192
                    }
                  }
                }
              },
              "network": {
                "type": "boolean"
              }
            }
          }
        },
        "toolchains": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "urn:literate-ai:schema:v1:content-identity"
          }
        },
        "external_input_variables": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
          }
        }
      }
    },
    "interpreter_identity": {
      "$ref": "urn:literate-ai:schema:v1:content-identity"
    },
    "target_identity": {
      "$ref": "urn:literate-ai:schema:v1:content-identity"
    },
    "environment_identity": {
      "$ref": "urn:literate-ai:schema:v1:content-identity"
    },
    "exports": {
      "$ref": "urn:literate-ai:schema:v2:retained-library-contracts#/$defs/export_set"
    },
    "destinations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "export_identity",
          "path"
        ],
        "properties": {
          "export_identity": {
            "$ref": "urn:literate-ai:schema:v1:content-identity"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "mounts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "export_identity",
          "artifact_tree_identity",
          "profile",
          "import_root",
          "runtime_manifest"
        ],
        "properties": {
          "export_identity": {
            "$ref": "urn:literate-ai:schema:v1:content-identity"
          },
          "artifact_tree_identity": {
            "$ref": "urn:literate-ai:schema:v1:content-identity"
          },
          "profile": {
            "enum": [
              "source",
              "wheel"
            ]
          },
          "import_root": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "runtime_manifest": {
            "anyOf": [
              {
                "allOf": [
                  {
                    "$ref": "urn:literate-ai:schema:v1:blob-ref"
                  },
                  {
                    "properties": {
                      "size": {
                        "minimum": 1,
                        "maximum": 16777216
                      },
                      "media_type": {
                        "const": "application/json"
                      }
                    },
                    "required": [
                      "media_type"
                    ]
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "profile": {
                  "const": "wheel"
                }
              }
            },
            "then": {
              "properties": {
                "runtime_manifest": {
                  "allOf": [
                    {
                      "$ref": "urn:literate-ai:schema:v1:blob-ref"
                    },
                    {
                      "properties": {
                        "size": {
                          "minimum": 1,
                          "maximum": 16777216
                        },
                        "media_type": {
                          "const": "application/json"
                        }
                      },
                      "required": [
                        "media_type"
                      ]
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "source_changes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "before",
          "after"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "before": {
            "anyOf": [
              {
                "$ref": "urn:literate-ai:schema:v1:blob-ref"
              },
              {
                "type": "null"
              }
            ]
          },
          "after": {
            "anyOf": [
              {
                "$ref": "urn:literate-ai:schema:v1:blob-ref"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "retired_roots": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4096,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_packages",
        "maximum_files",
        "maximum_entries",
        "maximum_file_bytes",
        "maximum_total_bytes",
        "maximum_metadata_bytes"
      ],
      "properties": {
        "maximum_packages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "maximum_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000
        },
        "maximum_entries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000000
        },
        "maximum_file_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "maximum_total_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967296
        },
        "maximum_metadata_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        }
      }
    }
  }
}
