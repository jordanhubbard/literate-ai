{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literate-ai:schema:v2:project-layout-framework-authority-result",
  "$ref": "literate-ai/project-layout-framework-authority-result@1",
  "$defs": {
    "record": {
      "$id": "literate-ai/project-layout-framework-authority-result@1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation",
        "plan",
        "journal",
        "writes",
        "full_containment",
        "qualification"
      ],
      "properties": {
        "schema": {
          "const": "literate-ai/project-layout-framework-authority-result@1"
        },
        "operation": {
          "enum": [
            "apply",
            "recover"
          ]
        },
        "plan": {
          "$ref": "urn:literate-ai:schema:v2:project-layout-framework-authority#/$defs/record"
        },
        "journal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "writes": {
          "const": true
        },
        "full_containment": {
          "const": false
        },
        "qualification": {
          "const": false
        },
        "applied": {
          "const": true
        },
        "producer_state": {
          "const": "unclassified"
        },
        "rolled_back": {
          "const": true
        },
        "retained_scaffolding": {
          "type": "array",
          "maxItems": 8192,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "operation": {
              "const": "apply"
            }
          },
          "required": [
            "applied",
            "producer_state"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "rolled_back"
                ]
              },
              {
                "required": [
                  "retained_scaffolding"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "operation": {
              "const": "recover"
            }
          },
          "required": [
            "rolled_back",
            "retained_scaffolding"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "applied"
                ]
              },
              {
                "required": [
                  "producer_state"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
