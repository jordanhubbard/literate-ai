{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literate-ai:schema:v3:standard-cargo-command-profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target",
    "toolchain",
    "manifest",
    "binary",
    "package_layout"
  ],
  "properties": {
    "schema": {
      "const": "urn:literate-ai:schema:v3:standard-cargo-command-profile"
    },
    "target": {
      "const": "cargo"
    },
    "toolchain": {
      "const": "cargo"
    },
    "manifest": {
      "allOf": [
        {
          "$ref": "urn:literate-ai:schema:v2:standard-command-profile-contracts#/$defs/relativePath"
        },
        {
          "pattern": "^(?:[^/]+/)*Cargo\\.toml$"
        }
      ]
    },
    "binary": {
      "$ref": "urn:literate-ai:schema:v2:standard-command-profile-contracts#/$defs/portableName"
    },
    "package_layout": {
      "const": "shared-siblings"
    }
  }
}
