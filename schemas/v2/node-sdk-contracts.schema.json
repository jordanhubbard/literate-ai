{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literate-ai:schema:v2:node-sdk-contracts",
  "title": "Explicit dual-format TypeScript SDK exports",
  "oneOf": [
    {
      "$ref": "urn:literate-ai:schema:v2:library-import-surface@3"
    },
    {
      "$ref": "urn:literate-ai:schema:v2:node-sdk-export-declaration@1"
    }
  ],
  "$defs": {
    "nodeSDKExportDeclaration": {
      "$id": "urn:literate-ai:schema:v2:node-sdk-export-declaration@1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "module",
        "stem",
        "format",
        "require",
        "import"
      ],
      "properties": {
        "schema": {
          "const": "urn:literate-ai:schema:v2:node-sdk-export-declaration@1"
        },
        "module": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "stem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 480
        },
        "format": {
          "const": "dual"
        },
        "require": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runtime",
            "declaration"
          ],
          "properties": {
            "runtime": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^cjs/.+\\.js$"
            },
            "declaration": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^cjs/.+\\.d\\.ts$"
            }
          }
        },
        "import": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runtime",
            "declaration"
          ],
          "properties": {
            "runtime": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^esm/.+\\.js$"
            },
            "declaration": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^esm/.+\\.d\\.ts$"
            }
          }
        }
      }
    },
    "nodeSDKLibraryImportSurface": {
      "$id": "urn:literate-ai:schema:v2:library-import-surface@3",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "language",
        "package",
        "capabilities",
        "node_sdk_exports",
        "package_boundaries"
      ],
      "properties": {
        "schema": {
          "const": "urn:literate-ai:schema:v2:library-import-surface@3"
        },
        "language": {
          "const": "typescript"
        },
        "package": {
          "type": "string",
          "minLength": 1,
          "maxLength": 214,
          "pattern": "^(?:@[a-z][a-z0-9._-]{0,126}/)?[a-z][a-z0-9._-]{0,126}$",
          "not": {
            "enum": [
              "node_modules",
              "_providers"
            ]
          }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "urn:literate-ai:schema:v2:library-capability-import@1"
          }
        },
        "node_sdk_exports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "urn:literate-ai:schema:v2:node-sdk-export-declaration@1"
          }
        },
        "package_boundaries": {
          "const": [
            {
              "path": "cjs/package.json",
              "type": "commonjs",
              "sha256": "e78adbbbe5741f27e8d900be349911234c1ae45c20a3f2fa293e2c8e5abf3c31"
            },
            {
              "path": "esm/package.json",
              "type": "module",
              "sha256": "48e847860dd4f0907ce91e346dbb00a4a12213163ad3d80a953c343eb9a11979"
            }
          ]
        }
      }
    }
  }
}
