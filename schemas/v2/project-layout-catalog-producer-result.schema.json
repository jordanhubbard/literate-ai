{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literate-ai:schema:v2:project-layout-catalog-producer-result",
  "$ref": "literate-ai/project-layout-catalog-producer-result@1",
  "$defs": {
    "record": {
      "$id": "literate-ai/project-layout-catalog-producer-result@1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation",
        "project",
        "plan_identity",
        "source_component",
        "destination_component",
        "target",
        "current",
        "writes",
        "journal",
        "finalized",
        "full_containment",
        "qualification",
        "catalog_intent_identity",
        "successor_plan_identity"
      ],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "plan_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "source_component": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "destination_component": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "schema": {
          "const": "literate-ai/project-layout-catalog-producer-result@1"
        },
        "operation": {
          "const": "renew"
        },
        "current": {
          "const": true
        },
        "writes": {
          "type": "boolean"
        },
        "journal": {
          "type": [
            "string",
            "null"
          ]
        },
        "finalized": {
          "const": false
        },
        "full_containment": {
          "const": false
        },
        "qualification": {
          "const": false
        },
        "command": {
          "type": "object",
          "required": [
            "schema",
            "mode",
            "component",
            "target"
          ],
          "properties": {
            "schema": {
              "const": "literate-ai/component-lock-command@1"
            },
            "mode": {
              "const": "update"
            },
            "component": {
              "type": "string"
            },
            "target": {
              "type": "string"
            }
          }
        },
        "catalog_intent_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "successor_plan_identity": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "oneOf": [
        {
          "properties": {
            "writes": {
              "const": false
            },
            "journal": {
              "type": "null"
            }
          },
          "not": {
            "required": [
              "command"
            ]
          }
        },
        {
          "properties": {
            "writes": {
              "const": true
            },
            "journal": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            }
          },
          "required": [
            "command"
          ]
        }
      ]
    }
  }
}
