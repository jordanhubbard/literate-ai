{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literate-ai:schema:v2:authored-retained-cargo",
  "$ref": "urn:literate-ai:schema:v2:authored-retained-cargo#/$defs/binding",
  "$defs": {
    "binding": {
      "$id": "literate-ai/authored-retained-cargo-binding@1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "importer_project_id",
        "evidence_store_id",
        "provider_reference",
        "selected_run_identity",
        "exports",
        "workspace_plan",
        "gate_policy",
        "test_inventory",
        "destinations"
      ],
      "properties": {
        "schema": {
          "const": "literate-ai/authored-retained-cargo-binding@1"
        },
        "importer_project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "evidence_store_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "provider_reference": {
          "$ref": "urn:literate-ai:schema:v2:authored-qualification-reference"
        },
        "selected_run_identity": {
          "$ref": "urn:literate-ai:schema:v1:content-identity"
        },
        "exports": {
          "$ref": "urn:literate-ai:schema:v2:retained-library-contracts#/$defs/export_set"
        },
        "workspace_plan": {
          "$ref": "urn:literate-ai:schema:v2:authored-retained-cargo#/$defs/reviewed_json"
        },
        "gate_policy": {
          "$ref": "urn:literate-ai:schema:v2:authored-retained-cargo#/$defs/reviewed_json"
        },
        "test_inventory": {
          "$ref": "urn:literate-ai:schema:v2:authored-retained-cargo#/$defs/reviewed_json"
        },
        "destinations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "export_identity",
              "path"
            ],
            "properties": {
              "export_identity": {
                "$ref": "urn:literate-ai:schema:v1:content-identity"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        }
      }
    },
    "reviewed_json": {
      "allOf": [
        {
          "$ref": "urn:literate-ai:schema:v1:blob-ref"
        },
        {
          "type": "object",
          "properties": {
            "media_type": {
              "const": "application/json"
            },
            "size": {
              "minimum": 1,
              "maximum": 268435456
            }
          }
        }
      ]
    },
    "admission_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "binding_identity",
        "reviewed_inputs_identity",
        "provider_reference_identity",
        "selected_run_identity",
        "exports_identity",
        "workspace_plan_identity",
        "gate_policy_identity",
        "test_inventory_identity",
        "source_retirement_identity",
        "consumer_inventory_identity",
        "original_source_scope_identity",
        "consumer_inputs_identity",
        "input_custody_policy_identity",
        "command_observation_identities",
        "target_outcomes",
        "coverage_counts"
      ],
      "properties": {
        "schema": {
          "const": "literate-ai/authored-retained-cargo-admission-receipt@1"
        },
        "binding_identity": {
          "$ref": "urn:literate-ai:schema:v1:content-identity"
        },
        "reviewed_inputs_identity": {
          "$ref": "urn:literate-ai:schema:v1:content-identity"
        },
        "provider_reference_identity": {
          "$ref": "urn:literate-ai:schema:v1:content-identity"
        },
        "selected_run_identity": {
          "$ref": "urn:literate-ai:schema:v1:content-identity"
        },
        "exports_identity": {
          "$ref": "urn:literate-ai:schema:v1:content-identity"
        },
        "workspace_plan_identity": {
          "$ref": "urn:literate-ai:schema:v1:content-identity"
        },
        "gate_policy_identity": {
          "$ref": "urn:literate-ai:schema:v1:content-identity"
        },
        "test_inventory_identity": {
          "$ref": "urn:literate-ai:schema:v1:content-identity"
        },
        "source_retirement_identity": {
          "$ref": "urn:literate-ai:schema:v1:content-identity"
        },
        "consumer_inventory_identity": {
          "$ref": "urn:literate-ai:schema:v1:content-identity"
        },
        "original_source_scope_identity": {
          "$ref": "urn:literate-ai:schema:v1:content-identity"
        },
        "consumer_inputs_identity": {
          "$ref": "urn:literate-ai:schema:v1:content-identity"
        },
        "input_custody_policy_identity": {
          "$ref": "urn:literate-ai:schema:v1:content-identity"
        },
        "command_observation_identities": {
          "type": "array",
          "items": {
            "$ref": "urn:literate-ai:schema:v1:content-identity"
          },
          "minItems": 1,
          "maxItems": 100000
        },
        "target_outcomes": {
          "type": "array",
          "items": {
            "$ref": "urn:literate-ai:schema:v2:authored-retained-cargo#/$defs/authored_admission_target"
          },
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "contains": {
            "anyOf": [
              {
                "properties": {
                  "passed_cases": {
                    "minItems": 1
                  }
                }
              },
              {
                "properties": {
                  "kind": {
                    "const": "custom-harness"
                  }
                }
              }
            ]
          }
        },
        "coverage_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "passed_cases",
            "reviewed_ignored_cases",
            "custom_commands",
            "excluded_targets"
          ],
          "properties": {
            "passed_cases": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "reviewed_ignored_cases": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "custom_commands": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "excluded_targets": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            }
          }
        }
      },
      "$id": "literate-ai/authored-retained-cargo-admission-receipt@1"
    },
    "authored_admission_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_root",
        "target_name",
        "target_kinds",
        "kind",
        "passed_cases",
        "ignored_cases",
        "command_observation_identities",
        "permission_identity"
      ],
      "properties": {
        "package_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "target_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
        },
        "target_kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "kind": {
          "enum": [
            "libtest",
            "custom-harness",
            "excluded"
          ]
        },
        "passed_cases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
          },
          "minItems": 0,
          "maxItems": 100000,
          "uniqueItems": true
        },
        "ignored_cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "reason"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                  }
                ]
              }
            }
          },
          "minItems": 0,
          "maxItems": 100000,
          "uniqueItems": true
        },
        "command_observation_identities": {
          "type": "array",
          "items": {
            "$ref": "urn:literate-ai:schema:v1:content-identity"
          },
          "minItems": 0,
          "maxItems": 2,
          "uniqueItems": true
        },
        "permission_identity": {
          "anyOf": [
            {
              "$ref": "urn:literate-ai:schema:v1:content-identity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "libtest"
              }
            }
          },
          "then": {
            "properties": {
              "command_observation_identities": {
                "minItems": 2,
                "maxItems": 2
              },
              "permission_identity": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "custom-harness"
              }
            }
          },
          "then": {
            "properties": {
              "command_observation_identities": {
                "minItems": 1,
                "maxItems": 1
              },
              "permission_identity": {
                "type": "null"
              },
              "passed_cases": {
                "maxItems": 0
              },
              "ignored_cases": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "excluded"
              }
            }
          },
          "then": {
            "properties": {
              "command_observation_identities": {
                "minItems": 0,
                "maxItems": 0
              },
              "permission_identity": {
                "$ref": "urn:literate-ai:schema:v1:content-identity"
              },
              "passed_cases": {
                "maxItems": 0
              },
              "ignored_cases": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "provisioning": {
      "$id": "literate-ai/authored-retained-cargo-provisioning@1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation",
        "origin",
        "binding_identity",
        "plan_identity",
        "provider_reference_identity",
        "verified_present_packages",
        "missing_packages",
        "published_packages",
        "consumer_gates_executed",
        "importer_admission",
        "source_retirement"
      ],
      "properties": {
        "schema": {
          "const": "literate-ai/authored-retained-cargo-provisioning@1"
        },
        "operation": {
          "enum": [
            "check",
            "materialize"
          ]
        },
        "origin": {
          "const": "authored"
        },
        "binding_identity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "plan_identity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "provider_reference_identity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "verified_present_packages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "missing_packages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "published_packages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "consumer_gates_executed": {
          "const": false
        },
        "importer_admission": {
          "const": false
        },
        "source_retirement": {
          "const": false
        }
      },
      "anyOf": [
        {
          "properties": {
            "operation": {
              "const": "check"
            },
            "verified_present_packages": {
              "const": 0
            },
            "missing_packages": {
              "minimum": 1
            },
            "published_packages": {
              "const": 0
            }
          }
        },
        {
          "properties": {
            "verified_present_packages": {
              "minimum": 1
            },
            "missing_packages": {
              "const": 0
            },
            "published_packages": {
              "const": 0
            }
          }
        },
        {
          "properties": {
            "operation": {
              "const": "materialize"
            },
            "verified_present_packages": {
              "minimum": 1
            },
            "missing_packages": {
              "const": 0
            },
            "published_packages": {
              "minimum": 1
            }
          }
        }
      ]
    },
    "exclusion_authority": {
      "$id": "literate-ai/authored-retained-cargo-exclusion-authority@1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "importer_project_id",
        "binding_identity",
        "permissions"
      ],
      "properties": {
        "schema": {
          "const": "literate-ai/authored-retained-cargo-exclusion-authority@1"
        },
        "importer_project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "binding_identity": {
          "$ref": "urn:literate-ai:schema:v1:content-identity"
        },
        "permissions": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:literate-ai:schema:v1:content-identity"
          }
        }
      }
    }
  }
}
