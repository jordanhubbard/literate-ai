{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literate-ai:schema:v2:project-layout-source-finalization-result",
  "$ref": "literate-ai/project-layout-source-finalization-result@1",
  "$defs": {
    "record": {
      "$id": "literate-ai/project-layout-source-finalization-result@1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation",
        "scope",
        "project",
        "plan_identity",
        "successor_plan_identity",
        "components_finalized",
        "closed_components",
        "normal_producers",
        "full_containment",
        "qualification"
      ],
      "properties": {
        "schema": {
          "const": "literate-ai/project-layout-source-finalization-result@1"
        },
        "operation": {
          "const": "finalize"
        },
        "scope": {
          "enum": [
            "framework",
            "catalog"
          ]
        },
        "project": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "plan_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "successor_plan_identity": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 4096
        },
        "components_finalized": {
          "const": true
        },
        "closed_components": {
          "type": "array",
          "maxItems": 8192,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "normal_producers": {
          "type": "array",
          "maxItems": 8192,
          "items": {
            "type": "object",
            "required": [
              "schema",
              "mode",
              "component",
              "target",
              "current"
            ],
            "properties": {
              "schema": {
                "const": "literate-ai/component-lock-command@1"
              },
              "mode": {
                "const": "check"
              },
              "current": {
                "const": true
              },
              "component": {
                "type": "string"
              },
              "target": {
                "type": "string"
              }
            }
          }
        },
        "full_containment": {
          "const": false
        },
        "qualification": {
          "const": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "framework"
              }
            }
          },
          "then": {
            "properties": {
              "successor_plan_identity": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
