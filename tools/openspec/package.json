{
  "name": "literate-ai-openspec-tooling",
  "private": true,
  "version": "0.0.0",
  "description": "Pinned OpenSpec validation CLI for Literate AI",
  "allowScripts": {
    "@fission-ai/openspec@1.14.3": true
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.14.3"
  },
  "scripts": {
    "dependencies:check": "node ../npm-audit/check-npm-audit.mjs .",
    "openspec:check": "npm run dependencies:check && openspec validate --all --strict --no-interactive"
  },
  "engines": {
    "node": ">=22.12"
  }
}
