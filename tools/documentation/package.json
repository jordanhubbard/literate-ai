{
  "name": "literate-ai-documentation-tooling",
  "private": true,
  "version": "0.0.0",
  "description": "Pinned documentation rendering tools for Literate AI",
  "allowScripts": {
    "puppeteer@25.16.0": true
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "11.16.0",
    "puppeteer": "25.16.0",
    "yauzl": "3.4.0"
  },
  "scripts": {
    "dependencies:check": "node ../npm-audit/check-npm-audit.mjs .",
    "documentation:check": "npm run dependencies:check && npm run mermaid:test && npm run mermaid:render --",
    "mermaid:render": "node scripts/check-mermaid.mjs",
    "mermaid:test": "node --test test/*.test.mjs ../npm-audit/test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "katex": "0.18.2"
  }
}
